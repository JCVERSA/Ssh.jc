# SSH.JC Control Center configuration

# Port the Control Center listens on (default 3000). Tunnels are forbidden
# from targeting this port so the console cannot expose itself.
GUI_PORT=3000

# Console password (choose ONE). Required in practice: without either
# variable, a random password is generated and printed once in the server
# log at startup.
GUI_PASSWORD=change-me

# Preferred for production: a scrypt hash instead of plaintext.
# Generate with: npm run set-password -- 'your-password'
# GUI_PASSWORD_HASH=scrypt$<salt-hex>$<hash-hex>

# Optional: path to Install.sh (defaults to ../Install.sh relative to gui/).
# SSHJC_SCRIPT_PATH=/home/user/Ssh.jc/Install.sh
