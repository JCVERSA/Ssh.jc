[Unit]
Description=SSH.JC Control Center (web console for Install.sh)
After=network.target

[Service]
Type=simple
# Run as a sudo-capable user: jobs execute Install.sh, which manages
# sshd, /etc/ssh/sshd_config and tunnel services.
User=root
WorkingDirectory=/opt/Ssh.jc/gui
# Put GUI_PORT / GUI_PASSWORD (or GUI_PASSWORD_HASH) in this file:
EnvironmentFile=/opt/Ssh.jc/gui/.env
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
